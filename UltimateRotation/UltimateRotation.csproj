<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.8.0</Version>
    <Author>Proteu</Author>
    <Name>Ultimate Rotation Guide</Name>
    <Punchline>Shows one player's ability order from an FFLogs ultimate pull.</Punchline>
    <Description>Loads one job's public FFLogs rDPS parses for an ultimate, grouped by percentile, and shows that player's ability order. In the selected ultimate, the guide starts at the pull and follows the fight, and it resets if you leave or wipe. Automatic rotation is off until you enable it. It then presses each due step for you, including on a striking dummy, and skips a step that cannot be used. Gemdraught is off unless you enable it.</Description>
    <Tags>ultimate;rotation;fflogs</Tags>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>UltimateRotation</RootNamespace>
    <AssemblyName>UltimateRotation</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimateRotation.Core\UltimateRotation.Core.csproj" />
  </ItemGroup>
</Project>
